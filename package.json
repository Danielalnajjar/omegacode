{
  "name": "omegacode",
  "version": "0.0.6",
  "description": "Run JS workflow files that orchestrate Codex, Claude Code, OpenCode, pi, and Grok agents (agent()/parallel()/pipeline()/phase()).",
  "license": "MIT",
  "author": "Sawyer Hood",
  "packageManager": "pnpm@11.8.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SawyerHood/omegacode.git"
  },
  "homepage": "https://github.com/SawyerHood/omegacode#readme",
  "keywords": [
    "agents",
    "workflow",
    "orchestration",
    "claude",
    "codex",
    "opencode",
    "pi",
    "grok",
    "multi-agent",
    "cli"
  ],
  "type": "module",
  "bin": {
    "omegacode": "dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ambient": {
      "types": "./dist/ambient.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skill",
    "builtins",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "pnpm": ">=11.4.0 <12"
  },
  "scripts": {
    "build": "pnpm --filter viewer build && tsup && node scripts/postbuild.mjs",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "node --test --import tsx ./test/*.test.ts",
    "start": "node dist/cli.js",
    "viewer:dev": "pnpm --filter viewer dev",
    "viewer:build": "pnpm --filter viewer build",
    "pnpm:devPreinstall": "node scripts/install-safe.mjs --dev-preinstall",
    "install:safe": "node scripts/install-safe.mjs --frozen",
    "verify:deps": "pnpm test && pnpm typecheck && pnpm build && pnpm pack --dry-run --json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.237",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
